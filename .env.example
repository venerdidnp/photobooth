# Salin menjadi .env lalu isi. Jangan di-commit.

# Server lokal
PORT=3000
HOST=127.0.0.1

# --- Upload Google Drive (lihat README: "Menyiapkan Google Drive") ---
# Kredensial OAuth jenis "Desktop app" dari Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ID folder tujuan (bagian terakhir URL folder Drive).
# Dengan izin drive.file, aplikasi hanya bisa memakai folder yang DIA buat sendiri.
# Cara paling mudah: kosongkan ini, lalu jalankan
#   npm run drive:setup -- --create-folder "Photobooth Informatika 6"
# (ID folder tersimpan otomatis di data/drive-folder.json dan mengalahkan nilai di sini).
DRIVE_FOLDER_ID=
