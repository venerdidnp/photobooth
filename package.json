{
  "name": "photobooth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Photobooth Dies Natalis HIMATIFA Level 6 (lokal, 1 laptop + 1 monitor)",
  "scripts": {
    "start": "vite build && tsx server/src/index.ts",
    "serve": "tsx server/src/index.ts",
    "build": "vite build",
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch server/src/index.ts\" \"vite\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "make-frame": "tsx scripts/make-sample-frame.ts",
    "drive:setup": "tsx scripts/drive-setup.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
